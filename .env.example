APP_NAME=AICompanion
DATABASE_PATH=data/aicompanion.sqlite3

# LLM_PROVIDER 可选：
# - mock：本地模拟回复，不需要 API key，适合开发 UI 和数据库功能
# - openai_compatible：调用 OpenAI Chat Completions 兼容格式的 API
# DeepSeek 使用 openai_compatible，地址 https://api.deepseek.com，模型以平台可用列表为准。
LLM_PROVIDER=mock

# OpenAI-compatible API settings.
# OpenAI 示例：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
LLM_TIMEOUT_SECONDS=60

# Optional speech APIs. Only the same API hostname can reuse LLM_API_KEY.
# Configure SPEECH_API_KEY separately when chat and speech use different providers.
SPEECH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASR_MODEL=glm-asr-2512
ASR_PROVIDER=zhipu
QWEN_ASR_MODEL=qwen-audio-3.0-asr-flash
TTS_MODEL=glm-tts
# SPEECH_API_KEY=your_speech_key

# Qwen anime voice. ASR stays independent; never use DeepSeek credentials here.
TTS_PROVIDER=system
QWEN_BASE_URL=https://maas.qianwenaiapi.com/api/v1
QWEN_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanlingxi
# Optional previous original voice, selectable as a backup in Settings.
QWEN_ORIGINAL_TTS_VOICE=

# Japanese speech translates each Chinese sentence; subtitles and chat remain Chinese.
SPEECH_LANGUAGE=zh
# Optional Emilia fan-art preview, not a rigged Cubism model. Empty keeps Live2D.
AVATAR_PREVIEW=
# Apply the Emilia fan persona once; later edits in Settings are kept.
CHARACTER_PRESET=
